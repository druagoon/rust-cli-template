[workspace]
resolver = "3"
members = ["derive"]

[workspace.package]
edition = "2024"
license = "MIT"
rust-version = "1.97.1"

[package]
name = "{{ project-name }}"
version = "0.1.0"
authors = ["{{ authors }}"]
description = "{{ description }}"
repository = "{{ repository }}"
edition.workspace = true
license.workspace = true
rust-version.workspace = true
publish = false
categories = ["command-line-interface"]
keywords = ["cli"]

[features]
default = ["config"]
dev-tools = [
    "dep:heck",
    "dep:tera",
]
config = [
    "dep:config",
    "dep:serde",
    "dep:serde_json",
    "dep:serde_yaml",
    "dep:shellexpand",
    "dep:toml",
]

[dependencies]
anyhow = "1.0.104"
clap = { version = "4.6.4", features = ["cargo", "derive", "env"] }
clap-verbosity-flag = "3.0.4"
clap_complete = "4.6.7"
cli_derive = { package = "{{ crate_name }}_derive", path = "derive" }
config = { version = "0.15.25", optional = true }
env_logger = "0.11.11"
heck = { version = "0.5.0", optional = true }
log = "0.4.33"
serde = { version = "1.0.229", features = ["derive"], optional = true }
serde_json = { version = "1.0.151", optional = true }
serde_yaml = { version = "0.9.34", optional = true }
shellexpand = { version = "3.1.2", optional = true }
tera = { version = "2.1.0", optional = true }
toml = { version = "1.1.3", features = ["preserve_order"], optional = true }
